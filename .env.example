# Copy these two values to .env.local from your Supabase project's API settings.
# The publishable key is intended for client apps; never use a service_role/secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set this to your deployed HTTPS AI server URL before producing an App Store build.
# For example: https://medexam-ai.example.com (never use a localhost URL in a store build).
# During local Expo development, MedExam can use the computer's Metro host automatically.
EXPO_PUBLIC_MEDEXAM_API_URL=
