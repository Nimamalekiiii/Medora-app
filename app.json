{
  "expo": {
    "name": "Medora",
    "slug": "medora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medexam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "bundleIdentifier": "no.medora.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Medora uses your selected photo as your profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9F2FC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "no.medora.app",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#E9F2FC",
          "dark": {
            "backgroundColor": "#081220"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "study-reminders",
          "color": "#2A78D6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Medora uses your selected photo as your profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
